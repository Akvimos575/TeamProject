<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- windows10.0.19041 даёт доступ к встроенному распознаванию текста Windows.Media.Ocr -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TeamProject</RootNamespace>
    <AssemblyName>MoonSweeperBot</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <!-- позволяет собирать проект и на Linux/macOS (для CI); запускается бот только на Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только ради System.Drawing (снимки экрана) и перечисления Keys -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
